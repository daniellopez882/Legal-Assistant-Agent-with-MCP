# Copy to .env and fill in. Never commit the result.
#
# The previous version of this file suggested Stripe live keys, Twilio,
# Google Calendar and CourtListener credentials, a SECRET_KEY and an
# ENCRYPTION_KEY. No code read any of them; they are gone.

# ---- Security -----------------------------------------------------------------
# Required on every /api/v1 route as the X-API-Key header. Production refuses to
# start while this is the placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme-in-production

# development | testing | staging | production
ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API. Empty means the
# localhost dev origins in development and no origin in production.
CORS_ALLOW_ORIGINS=

# ---- Model providers -----------------------------------------------------------
# Placeholders are treated as "not configured": the service boots, /ready says
# which provider is missing, and agent routes answer 503 until a key is set.
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder

# Per-agent models; each is overridable.
ORCHESTRATOR_MODEL=claude-sonnet-5
CONTRACT_REVIEWER_MODEL=claude-sonnet-5
CASE_RESEARCHER_MODEL=gpt-4o
DOCUMENT_DRAFTER_MODEL=claude-sonnet-5
DEADLINE_TRACKER_MODEL=gpt-4o
BILLING_CALCULATOR_MODEL=gpt-4o

# ---- Pinecone (case research, optional) --------------------------------------------
PINECONE_API_KEY=placeholder-pinecone-key
PINECONE_ENVIRONMENT=us-west-2
PINECONE_INDEX_NAME=legal-assistant-index

# ---- Database (optional; nothing in the API uses it yet) -----------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/legal_assistant
# DATABASE_ASYNC_URL=postgresql+asyncpg://user:password@localhost:5432/legal_assistant

# ---- Server ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# ---- Firm defaults -----------------------------------------------------------------------
DEFAULT_JURISDICTION=Texas
DEFAULT_BILLING_INCREMENT=0.1
CONFLICT_CHECK_REQUIRED=true
